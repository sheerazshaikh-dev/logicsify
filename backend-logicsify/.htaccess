Options -Indexes
RewriteEngine On

# Keep private application files inaccessible.
RewriteRule ^private(?:/|$) - [F,L]

# Route all API requests to the API front controller.
RewriteRule ^api/?$ api/index.php [QSA,L]
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

DirectoryIndex index.php index.html
