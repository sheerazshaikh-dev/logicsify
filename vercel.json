    },
    {
      "source": "/comparisons",
      "destination": "/_seo/comparisons/index.html"
    },
    {
      "source": "/engagement-models",
      "destination": "/_seo/engagement-models/index.html"
    },
    {
      "source": "/insights",
      "destination": "/_seo/insights/index.html"
    },
    {
      "source": "/testimonials",
      "destination": "/_seo/testimonials/index.html"
    },
    {
      "source": "/process",
      "destination": "/_seo/process/index.html"
    },
    {
      "source": "/technology",
      "destination": "/_seo/technology/index.html"
    },
    {
      "source": "/careers",
      "destination": "/_seo/careers/index.html"
    },
    {
      "source": "/contact",
      "destination": "/_seo/contact/index.html"
    },
    {
      "source": "/book-a-call",
      "destination": "/_seo/book-a-call/index.html"
    },
    {
      "source": "/technical-roadmap",
      "destination": "/_seo/technical-roadmap/index.html"
    },
    {
      "source": "/resources",
      "destination": "/_seo/resources/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/_seo/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/_seo/terms/index.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/_seo/services/:slug/index.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/api/seo-page?type=case_study&slug=:slug"
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/api/seo-page?type=portfolio&slug=:slug"
    },
    {
      "source": "/insights/:slug",
      "destination": "/api/seo-page?type=insight&slug=:slug"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/seo-page?type=guide&slug=:slug"
    },
    {
      "source": "/comparisons/:slug",
      "destination": "/api/seo-page?type=comparison&slug=:slug"
    },
    {
      "source": "/((?!api/|admin(?:/|$)|media(?:/|$)|uploads(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/resources/:slug",
      "destination": "/guides/:slug",
      "permanent": true
    },
