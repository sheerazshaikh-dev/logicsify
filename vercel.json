      "destination": "/services/ui-ux-design",
      "permanent": true
    },
    {
      "source": "/services/seo",
      "destination": "/services/seo-digital-marketing",
      "permanent": true
    },
    {
      "source": "/services/paid-advertising",
      "destination": "/services/seo-digital-marketing",
      "permanent": true
    },
    {
