{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logicsify-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_seo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/control/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/team-directory",
      "destination": "https://backend.logicsify.com/api/public/team-directory"
    },
    {
      "source": "/media/:path*",
      "destination": "https://backend.logicsify.com/uploads/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://backend.logicsify.com/uploads/:path*"
    },
    {
      "source": "/",
      "destination": "/_seo/home/index.html"
    },
    {
      "source": "/about",
      "destination": "/_seo/about/index.html"
    },
    {
      "source": "/team",
      "destination": "/_seo/team/index.html"
    },
    {
      "source": "/services",
      "destination": "/_seo/services/index.html"
    },
    {
      "source": "/work",
      "destination": "/_seo/work/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/_seo/portfolio/index.html"
    },
    {
      "source": "/company-profile",
      "destination": "/_seo/company-profile/index.html"
    },
    {
      "source": "/automation-lab",
      "destination": "/_seo/automation-lab/index.html"
    },
    {
      "source": "/integrations",
      "destination": "/_seo/integrations/index.html"
    },
    {
